# Copy to .env for `docker compose up`. Never commit the real .env.

# Exact browser-visible origin(s), comma-separated, no trailing slash.
# Used for WebSocket Origin checks, CORS and CSRF protection.
PUBLIC_ORIGIN=https://games.example.com

# Host port published by compose.yaml.
PORT=3000

# Postgres for the bundled database service. Use a long random password.
POSTGRES_DB=boredgamz
POSTGRES_USER=boredgamz
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Session signing key: at least 32 random bytes, e.g. `openssl rand -base64 48`.
JWT_SECRET_KEY=replace-with-at-least-32-cryptographically-random-bytes

# Set to true only behind a proxy that overwrites X-Forwarded-For / X-Real-IP
# (Fly, Render, Railway, nginx, Caddy...). Rate limits key on the client IP.
TRUST_PROXY=false

# Optional tuning.
# DB_MAX_CONNS=10
# LOG_LEVEL=info

# For a non-Compose deployment, provide DATABASE_URL directly instead of the
# POSTGRES_* values, e.g. a managed database with TLS:
# DATABASE_URL=postgres://user:password@host:5432/boredgamz?sslmode=require
