# Browser-visible origin used to validate WebSocket handshakes.
PUBLIC_ORIGIN=https://games.example.com

# Host port used by compose.yaml.
PORT=3000

# Account database. Generate unique production credentials.
POSTGRES_DB=boredgamz
POSTGRES_USER=boredgamz
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET_KEY=replace-with-at-least-32-cryptographically-random-bytes

# For a non-Compose deployment, provide DATABASE_URL directly.
# DATABASE_URL=postgres://user:password@host:5432/boredgamz?sslmode=require
